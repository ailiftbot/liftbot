# LiftBot — copy to .env and adjust
COMPOSE_PROJECT_NAME=liftbot

# ---------------------------------------------------------------- Django
# DEBUG defaults to OFF when unset. docker-compose.yml forces 1 for local dev;
# docker-compose.prod.yml forces 0. For `manage.py runserver` set it here.
DJANGO_DEBUG=1
# REQUIRED when DJANGO_DEBUG=0 (startup fails with the dev default). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-in-production-use-long-random-string
# Comma-separated hostnames (no ports). Add your public domain when deploying.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,liftbot.app
# Full origins including scheme (use https after Let's Encrypt)
DJANGO_CSRF_TRUSTED_ORIGINS=https://liftbot.app,http://liftbot.app,http://localhost:8001,http://127.0.0.1:8001
# DJANGO_LOG_LEVEL=INFO
# Error emails (django.request 500s) when DEBUG is off: "Name <a@b.com>,ops@b.com"
# ADMINS=

# Security (only applied when DJANGO_DEBUG=0). nginx usually terminates TLS,
# so the https redirect is opt-in. HSTS (1 year) is sent only when
# SECURE_SSL_REDIRECT=1, unless SECURE_HSTS_SECONDS is set explicitly.
# SECURE_SSL_REDIRECT=0
# SECURE_HSTS_SECONDS=31536000
# SESSION_COOKIE_SECURE=1
# CSRF_COOKIE_SECURE=1

# ---------------------------------------------------------------- Database
# Leave MYSQL_HOST blank to use SQLite (backend/db.sqlite3) for non-Docker dev.
# docker-compose sets MYSQL_HOST=db for the containers regardless.
MYSQL_ROOT_PASSWORD=liftbot_root
MYSQL_DATABASE=liftbot
MYSQL_USER=liftbot
MYSQL_PASSWORD=liftbot_pass
MYSQL_HOST=db
MYSQL_PORT=3306

# ---------------------------------------------------------------- Redis / Celery
# When REDIS_URL is set, Django's cache (rate limits) uses Redis; when it is
# unset, a per-process in-memory cache is used.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# Run Celery tasks inline (no worker) — handy for non-Docker dev.
# CELERY_TASK_ALWAYS_EAGER=0

# ---------------------------------------------------------------- RAG service
RAG_SERVICE_URL=http://rag:8100
# Shared secret between Django and the RAG service. MUST be changed in
# production (docker-compose.prod.yml refuses to start without it).
RAG_INTERNAL_TOKEN=liftbot-rag-internal-token

# ---------------------------------------------------------------- LLM / embeddings
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
# Optional model overrides (defaults shown)
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---------------------------------------------------------------- Public URLs
# Use https after running deploy/setup-ssl.sh on the VPS
PUBLIC_APP_URL=https://liftbot.app
PUBLIC_WIDGET_URL=https://liftbot.app/static/widget.js
PUBLIC_WIDGET_API_URL=https://liftbot.app/api/widget

# ---------------------------------------------------------------- Email
# The console backend prints emails (incl. signup codes) to the logs.
# Use SMTP in production or verification codes and invites never arrive.
DEFAULT_FROM_EMAIL=LiftBot <noreply@liftbot.app>
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# EMAIL_TIMEOUT=10
CONTACT_EMAIL_SALES=sales@liftbot.app
CONTACT_EMAIL_PRODUCT=contact@liftbot.app
CONTACT_EMAIL_SUPPORT=support@liftbot.app
EARLY_ACCESS_EMAIL=ailiftbot@gmail.com
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
# Wrong guesses before a verification code is disabled
OTP_MAX_ATTEMPTS=5
# Contact / early-access submissions allowed per IP per hour
PUBLIC_FORM_RATE_LIMIT=5

# ---------------------------------------------------------------- Stripe
# Onboarding payment uses Stripe Checkout. Without keys, payment is simulated
# only when DJANGO_DEBUG=1; in production the keys are required.
# Webhook endpoint: https://<your-domain>/billing/webhook/stripe/
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

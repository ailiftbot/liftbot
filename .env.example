# LiftBot — copy to .env and adjust
COMPOSE_PROJECT_NAME=liftbot

# Django
DJANGO_SECRET_KEY=change-me-in-production-use-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# MySQL
MYSQL_ROOT_PASSWORD=liftbot_root
MYSQL_DATABASE=liftbot
MYSQL_USER=liftbot
MYSQL_PASSWORD=liftbot_pass
MYSQL_HOST=db
MYSQL_PORT=3306

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# RAG service
RAG_SERVICE_URL=http://rag:8100
RAG_INTERNAL_TOKEN=liftbot-rag-internal-token

# LLM / embeddings (free tiers — set your keys)
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Public URLs (used by widget embed snippet)
# Change these when deploying (e.g. https://app.yourdomain.com)
PUBLIC_APP_URL=http://localhost:8001
PUBLIC_WIDGET_URL=http://localhost:8001/static/widget.js
PUBLIC_WIDGET_API_URL=http://localhost:8001/api/widget

# Email (console backend prints to Docker logs by default)
DEFAULT_FROM_EMAIL=LiftBot <noreply@liftbot.ai>
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1

# Stripe (optional — without keys, Billing → Select plan assigns manually)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
